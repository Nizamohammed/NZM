# Copy to .env for local use, and set these in the Vercel project settings.
# Never commit real values. .env is gitignored; this .example file is not.

# Last.fm API key for the home "Now" listening line.
# SERVER-SIDE ONLY - do NOT prefix with PUBLIC_ (that would ship it to the browser).
# Used only by /api/nowplaying.js. Create a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: Last.fm username to read (defaults to NizamMohammed).
LASTFM_USER=

# Web3Forms access key for the contact form. This one is a PUBLIC, submit-only
# identifier (safe in the client bundle), read as import.meta.env.PUBLIC_WEB3FORMS_KEY.
PUBLIC_WEB3FORMS_KEY=
