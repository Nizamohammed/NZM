---
// Site header — home variant (wordmark + primary nav + social) and internal variant.
// Styles live in global.css (ported from the converged artifact design system).
interface Props {
  variant?: 'home' | 'internal';
  active?: 'work' | 'publications' | 'frames' | 'reading';
}
const { variant = 'home', active } = Astro.props;
const cls = (k: string) =>
  'site-header__internal-link' + (k === active ? ' is-active' : '');
---
{variant === 'home' && (
  <header class="site-header site-header--home">
    <div class="site-header__inner">
      <div class="site-header__left">
        <a href="/" class="site-header__wordmark">NZM</a>
        <nav class="site-header__menu" aria-label="Primary navigation">
          <a href="/work">WORK</a><span aria-hidden="true">·</span><a href="/publications">PUBLICATIONS</a><span aria-hidden="true">·</span><a href="/frames">FRAMES</a><span aria-hidden="true">·</span><a href="/reading">READING</a>
        </nav>
      </div>
      <div class="site-header__right">
        <nav class="site-header__social" aria-label="Social links">
          <a href="https://github.com/Nizamohammed" target="_blank" rel="noopener">GitHub</a><span aria-hidden="true">·</span>
          <a href="https://linkedin.com/in/nizam-mohammed" target="_blank" rel="noopener">LinkedIn</a><span aria-hidden="true">·</span>
          <a href="https://x.com/NizamM0hammed" target="_blank" rel="noopener">X</a>
        </nav>
      </div>
    </div>
  </header>
)}
{variant === 'internal' && (
  <header class="site-header site-header--internal">
    <div class="site-header__inner">
      <a href="/" class="site-header__wordmark">NZM</a>
      <nav class="site-header__internal-nav" aria-label="Primary navigation">
        <a href="/work" class={cls('work')}>Work</a><span aria-hidden="true">·</span><a href="/publications" class={cls('publications')}>Publications</a><span aria-hidden="true">·</span><a href="/frames" class={cls('frames')}>Frames</a><span aria-hidden="true">·</span><a href="/reading" class={cls('reading')}>Reading</a>
      </nav>
    </div>
  </header>
)}
