---
// Thermal cursor: solid white circle following the mouse with lerp smoothing,
// using mix-blend-mode: difference to invert whatever sits beneath it.
// Disabled on touch, coarse pointer, and prefers-reduced-motion.
// Survives Astro View Transitions via transition:persist + document-level listeners.
---

<div id="thermal-cursor" transition:persist aria-hidden="true"></div>

<style is:global>
  #thermal-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFF4EA;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    mix-blend-mode: difference;
    transform: translate(-100px, -100px);
    transition:
      width 220ms cubic-bezier(0.22, 1, 0.36, 1),
      height 220ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 150ms ease;
    will-change: transform, width, height;
  }

  #thermal-cursor.is-hover {
    width: 70px;
    height: 70px;
    margin: -15px 0 0 -15px;
  }

  html.thermal-cursor-active,
  html.thermal-cursor-active * {
    cursor: none !important;
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    #thermal-cursor { display: none; }
  }
</style>

<script>
  const cursor = document.getElementById('thermal-cursor');

  if (cursor) {
    const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (supportsHover && !reduced) {
      const applyActive = () => document.documentElement.classList.add('thermal-cursor-active');
      applyActive();
      // View Transitions morph <html> from the incoming page and drop runtime
      // classes; re-add after each swap so the native cursor stays hidden.
      document.addEventListener('astro:after-swap', applyActive);

      const ease = 0.15;
      const baseSize = 40;

      // Start offscreen and hidden; reveal (and snap into place) on the first
      // real pointer move so no dot is painted at the viewport center on load.
      let mouseX = -100;
      let mouseY = -100;
      let cursorX = -100;
      let cursorY = -100;
      let visible = false;

      const hoverSelector =
        'a, button, input, textarea, select, [role="button"], .work-tile, .project__viz-frame';

      const onMove = (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        if (!visible) {
          // snap on first move so it appears at the pointer, not flying in from the corner
          cursorX = mouseX;
          cursorY = mouseY;
          visible = true;
        }
        cursor.style.opacity = '1';
      };

      const onOver = (e: MouseEvent) => {
        const target = e.target as Element | null;
        if (!target) return;
        if (target.tagName === 'IFRAME') {
          cursor.style.opacity = '0';
          cursor.classList.remove('is-hover');
          return;
        }
        if (target.closest && target.closest(hoverSelector)) {
          cursor.classList.add('is-hover');
        }
      };

      const onOut = (e: MouseEvent) => {
        const target = e.target as Element | null;
        if (target && target.closest && target.closest(hoverSelector)) {
          cursor.classList.remove('is-hover');
        }
      };

      document.addEventListener('mousemove', onMove, { passive: true });
      document.addEventListener('mouseover', onOver, { passive: true });
      document.addEventListener('mouseout', onOut, { passive: true });

      const animate = () => {
        cursorX += (mouseX - cursorX) * ease;
        cursorY += (mouseY - cursorY) * ease;
        cursor.style.transform = `translate(${cursorX - baseSize / 2}px, ${cursorY - baseSize / 2}px)`;
        requestAnimationFrame(animate);
      };

      requestAnimationFrame(animate);
    }
  }
</script>
