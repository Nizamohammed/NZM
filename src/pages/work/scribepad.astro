---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroScribepad from '../../assets/tile-scribepad.png';

const stack = ['Python', 'Markdown', 'CLI', 'local STT'];
---

<BaseLayout title="ScribePad — Nizam Mohammed" description="ScribePad: a Python command-line tool that turns long-form audio into clean, structured, lecture-style notes." headerVariant="internal" activeNav="work">
  <article class="project">

    <a href="/work" class="project__back project__back--top">← Work</a>

    <header class="project__hero">
      <div class="project__hero-media">
        <Image
          src={heroScribepad}
          alt="The ScribePad transcription command-line tool."
          class="project__hero-image"
          width={1600}
          height={1000}
        />
      </div>
      <div class="project__hero-heading">
        <h1 class="project__title">ScribePad</h1>
      </div>
    </header>

    <div class="project__meta">
      <span class="project__status">
        <span class="project__status-dot project__status-dot--done" aria-hidden="true"></span>
        Completed
      </span>
      <span aria-hidden="true">·</span>
      <span>Nov 2025 – Dec 2025</span>
      <span aria-hidden="true">·</span>
      <span>Personal project</span>
      <span aria-hidden="true">·</span>
      <a
        class="project__meta-link"
        href="https://github.com/Nizamohammed/Scribepad"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub ↗</a>
    </div>

    <section class="project__section" aria-labelledby="about-label">
      <p id="about-label" class="project__label">About</p>
      <div class="project__body">
        <p>ScribePad is a Python command-line tool I built to turn long-form audio into clean, structured notes. It runs local speech-to-text models to produce timestamped transcripts, then a tuned language-model layer reshapes the output into lecture-style outlines with headings and key ideas.</p>
      </div>
    </section>

    <section class="project__section" aria-labelledby="highlights-label">
      <p id="highlights-label" class="project__label">Highlights</p>
      <div class="project__body">
        <ul class="project__list">
          <li>Generates timestamped transcripts from long-form audio using local speech-to-text models, with cleaned Markdown export.</li>
          <li>Prototyped a notes layer that converts transcripts into lecture-style outlines with headings, key ideas, and worked examples.</li>
          <li>Built around tuned language-model prompts for the structuring step.</li>
        </ul>
      </div>
    </section>

    <section class="project__section" aria-labelledby="stack-label">
      <p id="stack-label" class="project__label">Stack</p>
      <div class="project__body">
        <ul class="project__chips">
          {stack.map((item) => <li class="project__chip">{item}</li>)}
        </ul>
      </div>
    </section>

    <a href="/work" class="project__back project__back--bottom">← Work</a>

  </article>
</BaseLayout>

<style>
  .project {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 40px 100px;
  }

  /* Back links */
  .project__back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--stone);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .project__back:hover {
    color: var(--ember);
  }
  .project__back--top {
    margin-bottom: 48px;
  }
  .project__back--bottom {
    margin-top: 80px;
  }

  /* Hero */
  .project__hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 40px;
  }
  .project__hero-media {
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-alt);
  }
  .project__hero-image {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .project__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(64px, 10vw, 126px);
    letter-spacing: -0.025em;
    line-height: 1.0;
    color: var(--stone);
  }

  /* Meta row */
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--stone);
    padding-bottom: 60px;
    border-bottom: 1px solid var(--hairline);
  }
  .project__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .project__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ember);
    display: inline-block;
  }
  .project__meta span[aria-hidden] {
    opacity: 0.6;
  }

  /* Two-column sections */
  .project__section {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 60px;
    align-items: start;
    padding: 60px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .project__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .project__body {
    max-width: 64ch;
  }
  .project__body > p {
    margin: 0 0 20px 0;
    font-family: var(--font-sans);
    font-size: clamp(18px, 1.7vw, 20px);
    line-height: 1.65;
    color: var(--ink);
  }
  .project__body > p:last-child {
    margin-bottom: 0;
  }

  /* Highlights groups */
  .project__group {
    margin-bottom: 32px;
  }
  .project__group:last-child {
    margin-bottom: 0;
  }
  .project__group-title {
    margin: 0 0 12px 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .project__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .project__list li {
    position: relative;
    padding-left: 20px;
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--ink);
  }
  .project__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--stone);
  }

  /* Stack chips */
  .project__chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .project__chip {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--stone);
    background: var(--paper-alt);
    padding: 6px 14px;
    border-radius: 100px;
    transition: background 200ms ease, color 200ms ease;
  }
  .project__chip:hover {
    background: color-mix(in srgb, var(--paper-alt) 80%, var(--ember));
    color: var(--ink);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .project__hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .project__title {
      font-size: clamp(54px, 13vw, 90px);
    }
  }

  @media (max-width: 720px) {
    .project__section {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .project {
      padding: 24px 24px 80px;
    }
    .project__back--top {
      margin-bottom: 32px;
    }
  }

  .project__status-dot--done {
    background: var(--stone);
  }

  .project__meta-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .project__meta-link:hover {
    color: var(--ember);
  }
</style>
