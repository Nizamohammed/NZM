---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroQualia from '../../assets/hero-qualia.png';
import heroLimeade from '../../assets/hero-limeade.png';
import heroGait from '../../assets/hero-gait.png';
import tileTetris from '../../assets/tile-tetris.png';
import tileScribepad from '../../assets/tile-scribepad.png';

const projects = [
  { slug: 'qualia', title: 'Qualia', meta: 'In Progress · 2026', image: heroQualia, alt: 'A visualization from the Qualia music-experience modeling project.', status: 'in-progress' },
  { slug: 'limeade', title: 'Limeade', meta: 'Completed · Feb 2026', image: heroLimeade, alt: 'A still from the Limeade scooter safety computer vision pipeline.', status: 'completed' },
  { slug: 'human-gait-analysis', title: 'Human Gait Analysis', meta: 'Completed · 2022–2023', image: heroGait, alt: 'A motion-sensor visualization from the Human Gait Analysis project.', status: 'completed' },
  { slug: 'tetris', title: 'Tetris', meta: 'Completed · Nov 2025', image: tileTetris, alt: 'The Tetris game built in Java.', status: 'completed' },
  { slug: 'scribepad', title: 'ScribePad', meta: 'Completed · 2025', image: tileScribepad, alt: 'The ScribePad transcription command-line tool.', status: 'completed' },
];
---

<BaseLayout title="Work — Nizam Mohammed" headerVariant="internal" activeNav="work">
  <section class="work-index">
    <p class="work-index__label">Work</p>
    <h1 class="work-index__heading">Selected projects in machine learning research and engineering.</h1>

    <div class="work-index__grid">
      {projects.map((project) => (
        <a href={`/work/${project.slug}`} class="work-card" aria-label={`Open ${project.title}`}>
          <div class="work-card__media">
            <Image
              src={project.image}
              alt={project.alt}
              class="work-card__image"
              width={1200}
              height={750}
            />
          </div>
          <div class="work-card__info">
            <h2 class="work-card__title">{project.title}</h2>
            <p class="work-card__meta">{project.meta}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work-index {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 40px 100px;
  }

  .work-index__label {
    margin: 0 0 24px 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .work-index__heading {
    margin: 0 0 64px 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 48px);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    max-width: 20ch;
  }

  .work-index__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 32px;
  }

  .work-card {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }

  .work-card__media {
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-alt);
    aspect-ratio: 4 / 3;
  }

  .work-card__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .work-card:hover .work-card__image {
    transform: scale(1.03);
  }

  .work-card__info {
    margin-top: 16px;
  }

  .work-card__title {
    margin: 0 0 4px 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--ink);
    transition: color 200ms ease;
  }

  .work-card:hover .work-card__title {
    color: var(--ember);
  }

  .work-card__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    color: var(--stone);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__image,
    .work-card__title {
      transition: none;
    }
    .work-card:hover .work-card__image {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .work-index {
      padding: 24px 24px 80px;
    }
    .work-index__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
