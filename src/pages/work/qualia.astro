        <li class="project__chip">Last.fm API</li>
        <li class="project__chip">DuckDB</li>
        <li class="project__chip">Parquet</li>
        <li class="project__chip">NumPy</li>
        <li class="project__chip">UMAP</li>
      </ul>
    </div>
  </section>

  <a href="/work" class="project__back project__back--bottom">← Work</a>
</article>
</BaseLayout>
