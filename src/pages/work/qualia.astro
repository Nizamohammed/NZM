---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroQualia from '../../assets/hero-qualia.png';

const stack = ['Python', 'gensim', 'Last.fm API', 'SQLite', 'Parquet (ZSTD)', 'NumPy', 'pandas'];
---

<BaseLayout title="Qualia — Nizam Mohammed" headerVariant="internal" activeNav="work">
  <article class="project">

    <a href="/work" class="project__back project__back--top">← Work</a>

    <header class="project__hero">
      <div class="project__hero-media">
        <Image
          src={heroQualia}
          alt="A 3D visualization of cross-genre experiential clusters from the Qualia project."
          class="project__hero-image"
          width={1600}
          height={1000}
        />
      </div>
      <div class="project__hero-heading">
        <h1 class="project__title">Qualia</h1>
      </div>
    </header>

    <div class="project__meta">
      <span class="project__status">
        <span class="project__status-dot" aria-hidden="true"></span>
        In Progress
      </span>
      <span aria-hidden="true">·</span>
      <span>2026</span>
      <span aria-hidden="true">·</span>
      <span>Independent research</span>
    </div>

    <section class="project__section" aria-labelledby="about-label">
      <p id="about-label" class="project__label">About</p>
      <div class="project__body">
        <p>Qualia is an independent research project developing a world model of human musical experience from behavioral data. Standard music recommendation systems learn from audio features or collaborative filtering signals; Qualia takes a different methodological premise: the experiential meaning of a song is encoded in the behavioral context surrounding it across human listening sessions. Under this hypothesis, songs occupying similar functional roles in listeners' lives should cluster together in a learned latent space, even across acoustically dissimilar genres.</p>
        <p>The first empirical stage validated this directly. From a self-scraped corpus of 1.25 billion scrobbles across 9,396 users, a Song2Vec signal check with artist-identity residualization revealed cross-genre experiential clusters — for instance, a sad-introspective-acoustic cluster spanning indie folk, Britpop, electronic, and UK indie. The remaining program is architectural: a Joint Embedding Predictive Architecture (JEPA) over listening sessions (Layer 1, in design), followed by transition modeling, policy learning, user-specific adaptation, and a reasoning interface (Layers 2–5, scoped). The end-state is a system that does not retrieve based on acoustic similarity but reasons about the experiential trajectory a listener is on at a given moment.</p>
      </div>
    </section>

    <section class="project__section" aria-labelledby="highlights-label">
      <p id="highlights-label" class="project__label">Highlights</p>
      <div class="project__body">
        <div class="project__group">
          <p class="project__group-title">Data</p>
          <ul class="project__list">
            <li>Self-scraped 1.25 billion scrobbles from 9,396 users via the Last.fm API, using a BFS social-graph crawl from 60 seed users.</li>
            <li>Built a SQLite → Parquet storage pipeline (~15 GB compressed, 188 files, ZSTD) with verified backups on institutional storage.</li>
          </ul>
        </div>
        <div class="project__group">
          <p class="project__group-title">Validation</p>
          <ul class="project__list">
            <li>Confirmed the core hypothesis through Experiment A: residualizing artist identity from Song2Vec embeddings reveals cross-genre experiential clusters — for example, a sad-introspective-acoustic cluster spanning indie folk, Britpop, electronic, and UK indie.</li>
            <li>Verified end-to-end preprocessing, sampled and full-scale exploratory analysis (9,396 users), and long-session quality checks.</li>
          </ul>
        </div>
        <div class="project__group">
          <p class="project__group-title">Now</p>
          <ul class="project__list">
            <li>Designing Layer 1: a Joint Embedding Predictive Architecture (JEPA) over listening sessions.</li>
            <li>Layers 2–5 (transition model, RL agent, user-specific fine-tuning, reasoning interface) are sketched but not yet built.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="project__section" aria-labelledby="stack-label">
      <p id="stack-label" class="project__label">Stack</p>
      <div class="project__body">
        <ul class="project__chips">
          {stack.map((item) => <li class="project__chip">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="project__visualizer" aria-labelledby="viz-label">
      <p id="viz-label" class="project__label">Visualizer</p>
      <div class="project__viz-frame">
        <iframe
          src="/embeds/qualia-experiment-a.html"
          title="Qualia Experiment A — interactive 3D visualization of cross-genre experiential clusters"
          loading="lazy"
          sandbox="allow-scripts allow-same-origin"
        ></iframe>
        <span class="project__viz-hint" aria-hidden="true">Drag to rotate · Scroll to zoom · Hover a point for details</span>
      </div>
      <p class="project__viz-caption">Experiment A — cross-genre experiential clusters revealed by artist-identity residualization.</p>
    </section>

    <a href="/work" class="project__back project__back--bottom">← Work</a>

  </article>
</BaseLayout>

<style>
  .project {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 40px 100px;
  }

  /* Back links */
  .project__back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--stone);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .project__back:hover {
    color: var(--ember);
  }
  .project__back--top {
    margin-bottom: 48px;
  }
  .project__back--bottom {
    margin-top: 80px;
  }

  /* Hero */
  .project__hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 40px;
  }
  .project__hero-media {
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-alt);
  }
  .project__hero-image {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .project__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(56px, 9vw, 110px);
    letter-spacing: -0.025em;
    line-height: 1.0;
    color: var(--stone);
  }

  /* Meta row */
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--stone);
    padding-bottom: 60px;
    border-bottom: 1px solid var(--hairline);
  }
  .project__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .project__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ember);
    display: inline-block;
  }
  .project__meta span[aria-hidden] {
    opacity: 0.6;
  }

  /* Two-column sections */
  .project__section {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 60px;
    align-items: start;
    padding: 60px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .project__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .project__body {
    max-width: 64ch;
  }
  .project__body > p {
    margin: 0 0 20px 0;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.65;
    color: var(--ink);
  }
  .project__body > p:last-child {
    margin-bottom: 0;
  }

  /* Highlights groups */
  .project__group {
    margin-bottom: 32px;
  }
  .project__group:last-child {
    margin-bottom: 0;
  }
  .project__group-title {
    margin: 0 0 12px 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .project__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .project__list li {
    position: relative;
    padding-left: 20px;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--ink);
  }
  .project__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--stone);
  }

  /* Stack chips */
  .project__chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .project__chip {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--stone);
    background: var(--paper-alt);
    padding: 6px 14px;
    border-radius: 100px;
    transition: background 200ms ease, color 200ms ease;
  }
  .project__chip:hover {
    background: color-mix(in srgb, var(--paper-alt) 80%, var(--ember));
    color: var(--ink);
  }

  /* Visualizer (full-width, intentional exception to two-column rhythm) */
  .project__visualizer {
    padding: 60px 0 0;
  }
  .project__visualizer .project__label {
    margin-bottom: 24px;
  }
  .project__viz-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 480px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper-alt);
    transition: border-color 250ms ease;
  }
  .project__viz-frame:hover {
    border-color: color-mix(in srgb, var(--ember) 45%, var(--hairline));
  }
  .project__viz-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .project__viz-hint {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    pointer-events: none;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--paper);
    background: color-mix(in srgb, var(--espresso) 82%, transparent);
    padding: 6px 12px;
    border-radius: 100px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 250ms ease, transform 250ms ease;
  }
  .project__viz-frame:hover .project__viz-hint {
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: none) {
    .project__viz-hint {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .project__viz-caption {
    margin: 16px 0 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--stone);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .project__hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .project__title {
      font-size: clamp(48px, 12vw, 80px);
    }
  }

  @media (max-width: 720px) {
    .project__section {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .project {
      padding: 24px 24px 80px;
    }
    .project__back--top {
      margin-bottom: 32px;
    }
    .project__viz-frame {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project__viz-frame,
    .project__viz-hint {
      transition: none;
    }
  }
</style>
