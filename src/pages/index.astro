---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
<div class="wrap">
    <section class="home-hero" aria-label="Introduction">
      <div>
        <h1 class="home-hero__name">Nizam<img class="home-hero__portrait" src="/portrait.jpg" alt="Portrait of Nizam Mohammed" width="480" height="480">Mohammed</h1>
        <p class="home-hero__role">ML Researcher &amp; Engineer</p>
        <p class="home-hero__loc">Chicago</p>
      </div>
    </section>

    <section class="sec intro" aria-labelledby="about-h">
      <div class="cols">
        <div><p class="label" id="about-h">About</p></div>
        <div class="intro__text">
          <p class="intro__lead">I build ML systems for sensing, perception, and human experience.</p>
          <p class="intro__body">My current focus is Qualia, a research project building a world model of musical experience, learned from how people listen rather than from audio features. Its first stage is published, with a conference paper in progress. I also built Voter Check, a public search of the 2026 Special Intensive Revision (SIR) draft electoral roll that volunteers in India use to help removed voters get back on the roll. Earlier work spans real-time computer vision for scooter rider safety and gait analysis at a robotics lab.</p>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="pubs-h">
      <div class="cols">
        <div><p class="label" id="pubs-h">Publications</p></div>
        <div class="cite-card">
          <p style="margin:0;max-width:66ch;font-size:15.5px;line-height:1.62;color:#3A342B">Mohammed, N., Rahman, A. B. S., Arachchige, D. D. K. (2026). <span style="font-style:italic">Project Qualia: Recovering Experiential Music Structure from Session Co-occurrence Data.</span> <a href="https://arxiv.org/abs/2609.10862" target="_blank" rel="noopener" style="font-size:.92em;color:var(--ember);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--ember) 35%,transparent)">arXiv:2609.10862</a>.</p>
        </div>
      </div>
    </section>

    <section class="sec worklist" aria-labelledby="work-h">
      <div class="head">
        <p class="label" id="work-h">Selected Work</p>
        <a class="alllink" href="/work">All work, 6 projects</a>
      </div>
      <div class="selected"><a class="pfeature" href="/work/qualia" style="--pc:#916F46"><span class="pfeature__media"><span class="pshot"><img src="/project/qualia-card.jpg" alt="Qualia"></span></span><span class="pfeature__text"><span class="pfeature__kicker"><span class="pfeature__n">01</span>Independent research</span><span class="pfeature__title">Qualia</span><span class="pfeature__dek">A world model of musical experience, learned from how people listen rather than from audio features.</span><span class="pfeature__meta"><span class="sdot sdot--prog"></span>In progress<span class="sdiv" aria-hidden="true">·</span>2026 · paper on arXiv</span><span class="pfeature__cue">View project →</span></span></a><a class="pfeature pfeature--flip" href="/work/voter-check" style="--pc:#6F7482"><span class="pfeature__media"><span class="pshot"><img src="/project/voter-card.jpg" alt="Voter Check"></span></span><span class="pfeature__text"><span class="pfeature__kicker"><span class="pfeature__n">02</span>Civic tool</span><span class="pfeature__title">Voter Check</span><span class="pfeature__dek">A public search of Hyderabad's 2026 draft electoral rolls, and the case system volunteers use to help removed voters get back on the roll.</span><span class="pfeature__meta"><span class="sdot sdot--live"></span>Live<span class="sdiv" aria-hidden="true">·</span>2026 · votercheck.me</span><span class="pfeature__cue">View project →</span></span></a></div>
    </section>

    <section class="sec" aria-labelledby="exp-h">
      <div class="cols">
        <div><p class="label" id="exp-h">Experience</p></div>
        <div class="exp">
          <div class="exp__group">
            <p class="exp__group-title">Work</p>
            <ul class="xplist">
              <li class="xp">
                <div class="xp__logo"><img src="/logos/depaul.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__title">Lead Research Assistant</p>
                  <p class="xp__org">Robotics and Assisted Locomotion (RAL) Lab, DePaul University</p>
                  <p class="xp__meta">Jun 2022 to May 2023 · 1 yr</p>
                  <p class="xp__desc">Built embedded sensor prototypes and an automated data pipeline, and trained regression models estimating limb position, direction, and speed for real-time prosthetic locomotion.</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="exp__group">
            <p class="exp__group-title">Education</p>
            <ul class="xplist">
              <li class="xp">
                <div class="xp__logo"><img src="/logos/depaul.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__title">B.S. Computer Science</p>
                  <p class="xp__org">DePaul University</p>
                  <p class="xp__meta">2022 to 2026</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="exp__group">
            <p class="exp__group-title">Volunteering</p>
            <ul class="xplist">
              <li class="xp xp--multi">
                <div class="xp__logo"><img src="/logos/yvi.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__org xp__org--head">Young Voice of India (YVI)</p>
                  <div class="xp__roles">
                    <div class="xp__role">
                      <p class="xp__title">ML Engineer</p>
                      <p class="xp__meta">Jan 2026 to present</p>
                      <p class="xp__desc">Built Voter Check, a public electoral-roll search and case system; now focused on data analysis and research for the organization.</p>
                    </div>
                    <div class="xp__role">
                      <p class="xp__title">Event Coordinator</p>
                      <p class="xp__meta">2021 · 1 yr</p>
                      <p class="xp__desc">Coordinated events for the organization's COVID relief programs.</p>
                    </div>
                  </div>
                </div>
              </li>
              <li class="xp">
                <div class="xp__logo"><img src="/logos/above.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__title">Student Volunteer</p>
                  <p class="xp__org">Above and Beyond Free Food Pantry</p>
                  <p class="xp__meta">Apr 2026 to Jul 2026 · 4 mos</p>
                  <p class="xp__desc">Distributed groceries, restocked inventory, and maintained the pantry space.</p>
                </div>
              </li>
              <li class="xp">
                <div class="xp__logo"><img src="/logos/umma.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__title">Senior News Editor</p>
                  <p class="xp__org">UMMA Ink</p>
                  <p class="xp__meta">Sep 2022 to Jun 2025 · 2 yrs 10 mos</p>
                  <p class="xp__desc">Edited the publication's current events section.</p>
                </div>
              </li>
              <li class="xp">
                <div class="xp__logo"><img src="/logos/nscs.png" alt=""></div>
                <div class="xp__body">
                  <p class="xp__title">Scholarship Chair</p>
                  <p class="xp__org">National Society of Collegiate Scholars (NSCS), DePaul chapter</p>
                  <p class="xp__meta">Apr 2022 to Sep 2023 · 1 yr 6 mos</p>
                  <p class="xp__desc">Helped students find and access scholarships offered by NSCS and its partners.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="frames" aria-labelledby="frames-h">
      <div class="head">
        <p class="label" id="frames-h">Frames</p>
        <a class="alllink" href="/frames">All frames</a>
      </div>
      <div class="frames__strip">
        <div class="frames__f a" style="background-image:url('/frames/looking-out.jpg')"><span class="cap">Yellowstone</span></div>
        <div class="frames__f b" style="background-image:url('/frames/alpine-lake.jpg')"><span class="cap">Lake Haiyaha</span></div>
        <div class="frames__f c" style="background-image:url('/frames/last-light.jpg')"><span class="cap">the last light</span></div>
        <div class="frames__f d" style="background-image:url('/frames/sky-city.jpg')"><span class="cap">Chicago</span></div>
      </div>
      <p class="frames__cap">A few frames from places I've been. The full set is on the Frames page.</p>
    </section>

    <section class="sec" aria-labelledby="now-h">
      <div class="cols">
        <div><p class="label" id="now-h">Now</p></div>
        <div class="now now--open">
          <p class="now__focus"><span class="dt">Chicago / Sep 2026</span>Preparing the Qualia paper for conference submission, and continuing data analysis and research for YVI.</p>
          <div class="now__listening">
            <span class="now__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="now__track">Recently played <b>Love Like Ghosts</b>, Lord Huron<span class="src">from Last.fm</span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="reading-h">
      <div class="cols">
        <div><p class="label" id="reading-h">Reading</p></div>
        <div>
          <div class="readnow readnow--sm">
            <span class="book" style="--bc:#2C2A1E"><span class="book__spine" aria-hidden="true"></span><span class="book__title">The Pilgrimage</span><span class="book__by">Paulo Coelho</span></span>
            <div class="readnow__text"><p class="readnow__t">The Pilgrimage</p><p class="readnow__by">Paulo Coelho</p><p class="readnow__note">On my desk now, plus a few reads online.</p><span class="reading__kind">Book</span></div>
          </div>
          <p class="reading__more"><a class="alllink" href="/reading">All reading</a></p>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Live "Now" listening line: replaces the static fallback with the track
    // played most today (from the same-origin /api/nowplaying function). Last.fm
    // data is untrusted external input, so it is inserted via textContent only.
    function initNowPlaying() {
      const el = document.querySelector('.now__track');
      if (!el || el.dataset.lfmDone === '1') return;
      fetch('/api/nowplaying', { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d || !d.ok || !d.track) return; // keep the static fallback line
          el.dataset.lfmDone = '1';
          el.textContent = d.mode === 'now' ? 'Now playing ' : 'Recently played ';
          const b = document.createElement('b');
          b.textContent = d.track;
          el.appendChild(b);
          if (d.artist) el.appendChild(document.createTextNode(', ' + d.artist));
          const src = document.createElement('span');
          src.className = 'src';
          src.textContent = 'from Last.fm';
          el.appendChild(src);
        })
        .catch(() => {});
    }
    document.addEventListener('astro:page-load', initNowPlaying);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNowPlaying);
    else initNowPlaying();
  </script>
</BaseLayout>
