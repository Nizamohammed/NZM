---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Frames · Nizam Mohammed" description="Photographs by Nizam Mohammed from Colorado, Yellowstone, the California coast, Tampa and Chicago." headerVariant="internal" activeNav="frames">
<div class="wrap"><header class="page-head"><p class="label">Photographs</p><h1 class="page-heading-reveal">Frames</h1><p class="lede">Places I have been, and how they looked to me. Colorado, Yellowstone, the California coast, Tampa and Chicago. Click any frame to view it.</p></header><figure class="fhero"><img src="/frames/sky-city.jpg" alt="sky over the city"><figcaption><span class="fcap">sky over the city</span><span class="fmeta">Chicago</span></figcaption></figure><section class="fgroup"><div class="fgroup__spread"><figure class="fitem fitem--lead is-land" style="--ar:1.5003"><span class="fitem__img"><img src="/frames/milky-way.jpg" alt="the milky way, captured by a friend"></span><figcaption><span class="fcap">the milky way, captured by a friend</span></figcaption></figure><div class="fgroup__intro"><h2>Mountains</h2><p>Colorado and Yellowstone.</p></div></div><div class="fgrid" style="--row-h:300px"><div class="frow"><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/alpine-lake.jpg" alt="Lake Haiyaha" loading="lazy"></span><figcaption><span class="fcap">Lake Haiyaha</span><span class="fmeta">Rocky Mountain NP, Colorado</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/alpine-morning.jpg" alt="on the trail to Lake Haiyaha" loading="lazy"></span><figcaption><span class="fcap">on the trail to Lake Haiyaha</span><span class="fmeta">Rocky Mountain NP, Colorado</span></figcaption></figure><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/bluebells.jpg" alt="bluebells by the stream" loading="lazy"></span><figcaption><span class="fcap">bluebells by the stream</span><span class="fmeta">Colorado</span></figcaption></figure></div><figure class="fitem fitem--solo" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/the-valley.jpg" alt="a valley in Colorado" loading="lazy"></span><figcaption><span class="fcap">a valley in Colorado</span></figcaption></figure><div class="frow"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/clear-water.jpg" alt="Bear Lake" loading="lazy"></span><figcaption><span class="fcap">Bear Lake</span><span class="fmeta">Rocky Mountain NP, Colorado</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/looking-out.jpg" alt="looking out" loading="lazy"></span><figcaption><span class="fcap">looking out</span><span class="fmeta">Yellowstone, Wyoming</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/elk.jpg" alt="an elk" loading="lazy"></span><figcaption><span class="fcap">an elk</span><span class="fmeta">Yellowstone, Wyoming</span></figcaption></figure><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/still-water.jpg" alt="still water, overcast" loading="lazy"></span><figcaption><span class="fcap">still water, overcast</span></figcaption></figure></div></div><div class="fgroup__spread fframe fgroup__spread--flip"><figure class="fitem fitem--lead is-port fframe__img" style="--ar:0.605"><span class="fitem__img"><img src="/frames/above-clouds.jpg" alt="above the clouds" loading="lazy"></span><figcaption class="sr-only"><span class="fcap">above the clouds</span><span class="fmeta">Colorado</span></figcaption></figure><div class="fframe__text"><p class="fframe__cap">above the clouds</p><p class="fframe__place">Colorado</p></div></div></section><section class="fgroup"><div class="fgroup__spread fgroup__spread--flip"><figure class="fitem fitem--lead is-land" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/houses-water.jpg" alt="houses on the water"></span><figcaption><span class="fcap">houses on the water</span><span class="fmeta">California</span></figcaption></figure><div class="fgroup__intro"><h2>Coast</h2><p>The Pacific, mostly Highway 1.</p></div></div><div class="fgrid" style="--row-h:322px"><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/turquoise-coast.jpg" alt="turquoise water" loading="lazy"></span><figcaption><span class="fcap">turquoise water</span><span class="fmeta">Big Sur, California</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/golden-gate.jpg" alt="the Golden Gate" loading="lazy"></span><figcaption><span class="fcap">the Golden Gate</span><span class="fmeta">San Francisco</span></figcaption></figure></div><figure class="fitem fitem--solo" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/grey-coast.jpg" alt="along Highway 1" loading="lazy"></span><figcaption><span class="fcap">along Highway 1</span><span class="fmeta">Big Sur, California</span></figcaption></figure><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/dusk-shore.jpg" alt="dusk on the shore" loading="lazy"></span><figcaption><span class="fcap">dusk on the shore</span><span class="fmeta">California</span></figcaption></figure><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/cloud-break.jpg" alt="cloud break at dusk" loading="lazy"></span><figcaption><span class="fcap">cloud break at dusk</span><span class="fmeta">California</span></figcaption></figure></div></div></section><section class="fgroup"><div class="fgroup__spread"><figure class="fitem fitem--lead is-land" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/window-sunset.jpg" alt="sunset through the window"></span><figcaption><span class="fcap">sunset through the window</span><span class="fmeta">Chicago</span></figcaption></figure><div class="fgroup__intro"><h2>City</h2><p>Mostly Chicago, at dusk.</p></div></div><div class="fgrid" style="--row-h:288px"><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/golden-hour.jpg" alt="skyline, golden hour" loading="lazy"></span><figcaption><span class="fcap">skyline, golden hour</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/last-light.jpg" alt="the last light, indoors" loading="lazy"></span><figcaption><span class="fcap">the last light, indoors</span><span class="fmeta">Chicago</span></figcaption></figure><figure class="fitem" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/window-lamp.jpg" alt="the lamp at last light" loading="lazy"></span><figcaption><span class="fcap">the lamp at last light</span><span class="fmeta">Chicago</span></figcaption></figure></div><figure class="fitem fitem--solo" style="--ar:1.3333"><span class="fitem__img"><img src="/frames/skyline-dusk.jpg" alt="the skyline at dusk" loading="lazy"></span><figcaption><span class="fcap">the skyline at dusk</span><span class="fmeta">Chicago</span></figcaption></figure><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/orange-clouds.jpg" alt="clouds at sunset" loading="lazy"></span><figcaption><span class="fcap">clouds at sunset</span><span class="fmeta">Chicago</span></figcaption></figure><figure class="fitem" style="--ar:0.8406"><span class="fitem__img"><img src="/frames/street-dusk.jpg" alt="the street at dusk" loading="lazy"></span><figcaption><span class="fcap">the street at dusk</span><span class="fmeta">Chicago</span></figcaption></figure><figure class="fitem" style="--ar:0.5628"><span class="fitem__img"><img src="/frames/rain-street.jpg" alt="the city in the rain" loading="lazy"></span><figcaption><span class="fcap">the city in the rain</span><span class="fmeta">Chicago</span></figcaption></figure></div><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:1.3323"><span class="fitem__img"><img src="/frames/skyline-silhouette.jpg" alt="skyline silhouette" loading="lazy"></span><figcaption><span class="fcap">skyline silhouette</span><span class="fmeta">Chicago</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/fog-night.jpg" alt="fog on the expressway" loading="lazy"></span><figcaption><span class="fcap">fog on the expressway</span><span class="fmeta">Chicago</span></figcaption></figure></div></div></section><section class="fgroup"><div class="fgroup__spread fgroup__spread--flip"><figure class="fitem fitem--lead is-port" style="--ar:0.75"><span class="fitem__img"><img src="/frames/reading-room.jpg" alt="the reading room"></span><figcaption><span class="fcap">the reading room</span><span class="fmeta">DePaul University, Chicago</span></figcaption></figure><div class="fgroup__intro"><h2>Rooms</h2><p>Interiors and passages.</p></div></div><div class="fgrid" style="--row-h:320px"><div class="frow"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/portrait-room.jpg" alt="the portrait room" loading="lazy"></span><figcaption><span class="fcap">the portrait room</span><span class="fmeta">The Wizarding World, Florida</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/walls-faces.jpg" alt="walls of faces" loading="lazy"></span><figcaption><span class="fcap">walls of faces</span><span class="fmeta">The Wizarding World, Florida</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/under-arch.jpg" alt="under the arch" loading="lazy"></span><figcaption><span class="fcap">under the arch</span><span class="fmeta">The Wizarding World, Florida</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/vine-passage.jpg" alt="the vine passage" loading="lazy"></span><figcaption><span class="fcap">the vine passage</span><span class="fmeta">Carmel-by-the-Sea, California</span></figcaption></figure></div><div class="frow frow--rest" style="--row-h:420px"><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/courtyard.jpg" alt="the courtyard" loading="lazy"></span><figcaption><span class="fcap">the courtyard</span><span class="fmeta">San Francisco</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/blossom.jpg" alt="spring blossom" loading="lazy"></span><figcaption><span class="fcap">spring blossom</span><span class="fmeta">Chicago</span></figcaption></figure><figure class="fitem" style="--ar:0.75"><span class="fitem__img"><img src="/frames/flowers-light.jpg" alt="Mona Lavender, from a friend" loading="lazy"></span><figcaption><span class="fcap">Mona Lavender, from a friend</span></figcaption></figure></div></div></section><p class="frames__closing">More to come.</p></div>
<div class="lb" id="lb" aria-hidden="true"><button class="lb__x" id="lbx" aria-label="Close">×</button><button class="lb__nav lb__prev" id="lbprev" aria-label="Previous frame">‹</button><button class="lb__nav lb__next" id="lbnext" aria-label="Next frame">›</button><figure class="lb__fig"><img id="lbimg" src="" alt=""><figcaption class="lb__cap"><span id="lbc"></span><span class="lb__meta" id="lbm"></span></figcaption></figure><div class="lb__count" id="lbn"></div><div class="lb__strip" id="lbstrip" aria-hidden="true"></div></div><script>(function(){
  var current=null; // API of the lightbox mounted in the current DOM
  function initLightbox(){
    var lb=document.getElementById("lb");
    if(!lb||lb.dataset.lbInit==="1")return; // once per fresh DOM (View-Transition safe)
    lb.dataset.lbInit="1";
    var img=document.getElementById("lbimg"),c=document.getElementById("lbc"),m=document.getElementById("lbm"),n=document.getElementById("lbn"),strip=document.getElementById("lbstrip");
    var figs=[].slice.call(document.querySelectorAll(".fhero,.fitem"));
    var items=figs.map(function(f){var i=f.querySelector("img"),cap=f.querySelector(".fcap"),mt=f.querySelector(".fmeta");return {src:i.getAttribute("src"),alt:i.alt,cap:cap?cap.textContent:i.alt,meta:mt?mt.textContent:""};});
    var idx=0, thumbs=[];
    items.forEach(function(it,i){var b=document.createElement("button");b.type="button";b.className="lb__thumb";var im=document.createElement("img");im.src=it.src;im.alt="";im.loading="lazy";b.appendChild(im);b.addEventListener("click",function(e){e.stopPropagation();show(i);});strip.appendChild(b);thumbs.push(b);});
    function show(i){idx=(i+items.length)%items.length;var it=items[idx];img.style.opacity="0";var pre=new Image();pre.onload=function(){img.src=it.src;img.alt=it.alt;requestAnimationFrame(function(){img.style.opacity="1";});};pre.src=it.src;c.textContent=it.cap;m.textContent=it.meta;m.style.display=it.meta?"block":"none";n.textContent=(idx+1)+" / "+items.length;thumbs.forEach(function(t,k){t.classList.toggle("on",k===idx);});if(thumbs[idx])thumbs[idx].scrollIntoView({inline:"center",block:"nearest"});[items[(idx+1)%items.length],items[(idx-1+items.length)%items.length]].forEach(function(x){(new Image()).src=x.src;});}
    function open(i){show(i);lb.classList.add("on");lb.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";}
    function close(){lb.classList.remove("on");lb.setAttribute("aria-hidden","true");document.body.style.overflow="";img.src="";}
    figs.forEach(function(f,i){f.style.cursor="zoom-in";f.addEventListener("click",function(){open(i);});});
    img.addEventListener("click",function(e){e.stopPropagation();show(idx+1);});
    document.getElementById("lbx").addEventListener("click",function(e){e.stopPropagation();close();});
    document.getElementById("lbprev").addEventListener("click",function(e){e.stopPropagation();show(idx-1);});
    document.getElementById("lbnext").addEventListener("click",function(e){e.stopPropagation();show(idx+1);});
    lb.addEventListener("click",function(e){if(e.target===lb)close();});
    current={isOpen:function(){return lb.classList.contains("on");},close:close,prev:function(){show(idx-1);},next:function(){show(idx+1);}};
  }
  // keydown bound once at module scope; delegates to the current lightbox
  document.addEventListener("keydown",function(e){if(!current||!current.isOpen())return;if(e.key==="Escape")current.close();else if(e.key==="ArrowLeft")current.prev();else if(e.key==="ArrowRight")current.next();});
  // init on soft View-Transition navigations, AND independently on the initial
  // load so the lightbox never depends on the ViewTransitions script firing.
  document.addEventListener("astro:page-load",initLightbox);
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",initLightbox);else initLightbox();
})();</script>
</BaseLayout>
